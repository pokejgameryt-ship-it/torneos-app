<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scoreboard Overlay</title>
  <link href="https://fonts.googleapis.com/css2?family=Impact&family=Orbitron:wght@400;700;900&family=Press+Start+2P&family=Bebas+Neue&family=Roboto+Condensed:wght@400;700&family=Inter:wght@300;400;600;700;900&family=Rajdhani:wght@500;600;700&family=Teko:wght@400;500;600;700&family=Exo+2:wght@400;600;700;800;900&family=Oswald:wght@400;500;600;700&family=Barlow+Condensed:wght@400;600;700;800&family=Russo+One&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: transparent; overflow: visible; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

    /* =============================================
       PROFESSIONAL LAYOUT - DISTRIBUTED ELEMENTS
       Order: NAME1 FLAG1 SCORE1 | LOGO | SCORE2 FLAG2 NAME2
       Equal spacing (120px) between all elements
    ============================================= */
    .sb {
      position: relative; width: 3680px; height: 560px;
      display: flex; align-items: center; justify-content: center;
      overflow: visible;
    }

    /* Left side: NAME -> FLAG -> SCORE */
    .left-group {
      position: absolute; left: 100px; top: 50%; transform: translateY(-50%);
      display: flex; align-items: center; gap: 120px; z-index: 1;
    }

    /* Right side: SCORE -> FLAG -> NAME */
    .right-group {
      position: absolute; right: 100px; top: 50%; transform: translateY(-50%);
      display: flex; align-items: center; gap: 120px; z-index: 1;
    }
    .right-group .pname { text-align: right; }

    .sb .mid {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 640px; height: 100%;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; z-index: 2;
    }

    .sb .pname {
      font-size: 96px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      max-width: 800px; line-height: 1.1;
    }

    .sb .pflag {
      width: 140px; height: 140px; z-index: 1;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
      display: flex; align-items: center; justify-content: center;
    }
    .sb .pflag img.flag {
      width: 140px; height: 140px;
      vertical-align: middle;
    }

    .sb .pscore {
      width: 248px; height: 248px;
      display: flex; align-items: center; justify-content: center;
      font-size: 120px; font-weight: 900; z-index: 3;
    }

    .sb .phase { font-size: 38px; font-weight: 700; text-transform: uppercase; letter-spacing: 6px; }
    .sb .fmt { font-size: 48px; font-weight: 800; padding: 10px 60px; text-transform: uppercase; letter-spacing: 4px; }

    .sb .tname {
      position: absolute; bottom: -80px; left: 50%; transform: translateX(-50%);
      font-size: 40px; font-weight: 600; letter-spacing: 6px;
      text-transform: uppercase; white-space: nowrap;
    }
    .sb .logo {
      max-width: 400px; max-height: 280px; object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    }
    .sb .sponsor {
      position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
      font-size: 36px; letter-spacing: 8px; text-transform: uppercase;
      white-space: nowrap; opacity: 0.6;
    }

    /* =============================================
       CUSTOM COLORS OVERRIDE
    ============================================= */
    .custom-colors .pname { color: var(--cc, var(--pc)) !important; -webkit-text-fill-color: var(--cc, var(--pc)) !important; background: none !important; text-shadow: none !important; }
    .custom-colors #p2n { color: var(--cc2, var(--pc2)) !important; -webkit-text-fill-color: var(--cc2, var(--pc2)) !important; }
    .custom-colors .pscore { background: var(--cc, var(--pc)) !important; color: #fff !important; border-color: var(--cc, var(--pc)) !important; box-shadow: none !important; text-shadow: none !important; }
    .custom-colors #p2s { background: var(--cc2, var(--pc2)) !important; }
    .custom-colors .phase { color: var(--cc, var(--pc)) !important; -webkit-text-fill-color: var(--cc, var(--pc)) !important; background: none !important; }
    .custom-colors .fmt { background: var(--cc2, var(--pc2)) !important; color: #fff !important; border: none !important; box-shadow: none !important; }
    .custom-colors .tname { color: var(--cc2, var(--pc2)) !important; }
    .custom-colors .sponsor { color: var(--cc2, var(--pc2)) !important; }
    .custom-colors .sb { border-color: var(--cc, var(--pc)) !important; background: color-mix(in srgb, var(--cc, var(--pc)) 5%, transparent) !important; }
    .custom-colors .mid { border-color: var(--cc, var(--pc)) !important; background: rgba(0,0,0,0.5) !important; }

    /* =============================================
       STYLE: POKÉMON CHAMPIONS (Default)
    ============================================= */
    .s-pokemon-champions .sb { background: #000; }
    .s-pokemon-champions .pname { color: gold; font-family: 'Impact', sans-serif; }
    .s-pokemon-champions .pscore { background: #000; border: 8px solid gold; color: gold; }
    .s-pokemon-champions .mid { background: #000; }
    .s-pokemon-champions .phase { color: gold; }
    .s-pokemon-champions .fmt { background: #000; border: 2px solid gold; color: gold; }
    .s-pokemon-champions .tname { color: gold; }
    .s-pokemon-champions .sponsor { color: gold; }

    /* =============================================
       STYLE: ESPORTS GOLD
    ============================================= */
    .s-esports-gold .sb { background: linear-gradient(180deg, #0d0f14, #151820, #1a1e28); border-top: 8px solid var(--pc, #d4af37); border-bottom: 4px solid rgba(212,175,55,0.2); box-shadow: 0 32px 128px rgba(0,0,0,0.6); }
    .s-esports-gold .pname { background: linear-gradient(135deg, var(--pc, #d4af37), var(--pc2, #f5d77a)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .s-esports-gold .pscore { background: linear-gradient(135deg, #1a1e28, #0d0f14); border: 8px solid var(--pc, #d4af37); color: var(--pc, #d4af37); box-shadow: 0 0 80px color-mix(in srgb, var(--pc, #d4af37) 20%, transparent); }
    .s-esports-gold .mid { background: linear-gradient(180deg, rgba(13,15,20,0.95), rgba(21,24,32,0.9)); border-left: 4px solid color-mix(in srgb, var(--pc, #d4af37) 30%, transparent); border-right: 4px solid color-mix(in srgb, var(--pc, #d4af37) 30%, transparent); }
    .s-esports-gold .phase { background: linear-gradient(135deg, var(--pc, #d4af37), var(--pc2, #b8962e)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .s-esports-gold .fmt { background: linear-gradient(135deg, var(--pc, #d4af37), var(--pc2, #b8962e)); color: #0d0f14; }
    .s-esports-gold .tname { color: color-mix(in srgb, var(--pc, #d4af37) 50%, transparent); }
    .s-esports-gold .sponsor { color: color-mix(in srgb, var(--pc, #d4af37) 40%, transparent); }

    /* =============================================
       STYLE: CYBER NEON
    ===